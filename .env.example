# Environment Variables
PORT=3000
NODE_ENV=development

# Database Configuration
DB_SERVER=localhost
DB_NAME=MedicineReminderDB
DB_USER=your_username
DB_PASSWORD=your_password
DB_PORT=1433

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=*

# ================================================
# Firebase Cloud Messaging Configuration (NEW)
# ================================================

# Option 1: Using Service Account JSON File (Recommended)
# Download firebase-service-account.json from Firebase Console
# Place it in backend folder and set path below:
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Option 2: Using JSON String (Alternative)
# Paste entire JSON content as single line:
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Battery Monitoring Configuration
BATTERY_ALERT_RATE_LIMIT=30
BATTERY_LOW_THRESHOLD=20
